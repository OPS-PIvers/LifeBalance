  "availableOperations": {
    "accounts": [
      "addAccount(account)",
      "updateAccount(accountId, updates)",
      "deleteAccount(accountId)"
    ],
    "budgetBuckets": [
      "addBudgetBucket(bucket)",
      "updateBudgetBucket(bucketId, updates)",
      "deleteBudgetBucket(bucketId)"
    ],
    "transactions": [
      "addTransaction(transaction)",
      "updateTransaction(transactionId, updates)",
      "deleteTransaction(transactionId)"
    ],
    "habits": [
      "addHabit(habit)",
      "updateHabit(habitId, updates)",
      "deleteHabit(habitId)",
      "toggleHabit(habitId)"
    ],
    "meals": [
      "addMeal(meal)",
      "updateMeal(mealId, updates)",
      "deleteMeal(mealId)"
    ],
    "shoppingList": [
      "addShoppingItem(item)",
      "updateShoppingItem(itemId, updates)",
      "deleteShoppingItem(itemId)"
    ],
    "todos": [
      "addTodo(todo)",
      "updateTodo(todoId, updates)",
      "deleteTodo(todoId)",
      "toggleTodo(todoId)"
    ]
  },
  "keyRoutes": {
    "/": "Dashboard - Main overview with AI insights",
    "/budget": "Budget - Finance management and safe-to-spend",
    "/habits": "Habits - Habit tracker with points and streaks",
    "/meals": "Meals - Meal planning and shopping lists",
    "/settings": "Settings - App preferences and household management"
  },
  "testModeFeatures": {
    "enabled": [
      "Full UI navigation",
      "CRUD operations (in-memory)",
      "Habit tracking and streaks",
      "Budget calculations",
      "Safe-to-spend calculations",
      "Form validation",
      "Toast notifications",
      "Modal dialogs"
    ],
    "disabled": [
      "Firebase authentication (mocked)",
      "Real-time sync (no backend)",
      "AI features (requires VITE_GEMINI_API_KEY)",
      "Push notifications (requires FCM)",
      "Data persistence (session only)"
    ]
  },
  "environmentRequirements": {
    "nodeVersion": ">=18.0.0",
    "npm": ">=9.0.0",
    "requiredEnvVars": {
      "VITE_ENABLE_TEST_MODE": "true"
    },
    "optionalEnvVars": {
      "VITE_GEMINI_API_KEY": "For AI features (receipt scanning, meal suggestions)",
      "VITE_FIREBASE_*": "For real Firebase integration (not needed in test mode)"
    }
  },
  "quickCommands": {
    "setup": "./setup-test-mode.sh",
    "install": "npm install",
    "dev": "npm run dev",
    "build": "npm run build",
    "lint": "npm run lint",
    "testModeUrl": "http://localhost:3000/#/login?test=true"
  }
}
