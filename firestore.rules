rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is member of household
    // Used for subcollections where we don't have access to the household doc's memberUids field directly
    function isMemberOf(householdId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // Helper function: Check if user is admin of household
    function isAdminOf(householdId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // 🛡️ SENTINEL SECURITY HELPERS: Data Validation
    function isValidString(text, max) {
      return text is string && text.size() > 0 && text.size() <= max;
    }

    function isValidOptionalString(text, max) {
      return text == null || (text is string && text.size() <= max); // Allow empty strings for optional fields if needed, or strictly reuse isValidString?
      // If optional, it can be null. If string, it should follow string rules.
      // Let's allow empty strings for optional fields to be safe, but enforce max length.
    }

    function isValidNumber(num) {
      return num is number;
    }

    function isValidOptionalNumber(num) {
      return num == null || num is number;
    }

    function isValidBoolean(val) {
      return val is bool;
    }

    // Households collection
    match /households/{householdId} {
      // 🛡️ SENTINEL SECURITY FIX: Prevent IDOR/Information Disclosure
      // Only members can read the household document.
      // OPTIMIZATION: Check memberUids array on the document itself to avoid an extra read cost (exists() call).
      // This aligns with the list rule below.
      allow get: if (isAuthenticated() && request.auth.uid in resource.data.memberUids) || request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2";

      // Allow listing only if user is a member (prevents enumeration of all households)
      // Admin can list all households for the AI Meter
      allow list: if (request.auth.uid in resource.data.memberUids) || request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2";

      // 🛡️ SENTINEL FIX: Validate household name on creation
      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAny(['name']) &&
                    isValidString(request.resource.data.name, 50);
      // Allow update if member (but cannot modify immutable fields).
      // 🛡️ SECURITY FIX: Updates are ONLY allowed if isMemberOf(householdId) returns true.
      // This implicitly requires the user to have a valid member document in the members/ subcollection.
      // Since creating a member document requires validating the invite code (see members create rule),
      // this ensures that no one can add themselves to memberUids without a valid invite.
      allow update: if isMemberOf(householdId) &&
                        // 🛡️ SENTINEL FIX: Validate household name if being updated
                        isValidOptionalString(request.resource.data.get('name', null), 50) &&
                        // Prevent modification of immutable fields
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'inviteCode']) &&
                        // 🛡️ SENTINEL FIX: Restrict memberUids modifications
                        // 1. Adding members: Only allow adding YOURSELF (request.auth.uid). Prevents adding unauthorized users.
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids']) ||
                          (
                            request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0 ||
                            (
                              request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 1 &&
                              request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).hasAny([request.auth.uid])
                            )
                          )
                        ) &&
                        // 2. Removing members: Admin can remove anyone. Users can only remove THEMSELVES.
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids']) ||
                          isAdminOf(householdId) ||
                          (
                            resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0 ||
                            (
                              resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 1 &&
                              resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).hasAny([request.auth.uid])
                            )
                          )
                        );
      allow delete: if isAdminOf(householdId);

      // Members subcollection
      match /members/{memberId} {
        // Allow users to read their own member doc (to check if already joined) or if they're a member
        allow read: if isMemberOf(householdId) || request.auth.uid == memberId;

        // Secure creation: Must be creator OR provide valid invite code
        // - Household creator can create their member doc with any role.
        // - Invite-based joins must not assign themselves an admin role.
        allow create: if isAuthenticated() && request.auth.uid == memberId && (
          // Case 1: Household creator (admin) - createdBy check
          get(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid ||
          // Case 2: Joining via Invite Code (non-creator)
          (
            request.resource.data.inviteCode != null &&
            exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)) &&
            get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.householdId == householdId &&
            (
              // Non-creators joining via invite cannot assign themselves admin role
              !request.resource.data.keys().hasAny(['role']) ||
              request.resource.data.role != 'admin'
            )
          ) ||
          // Case 3: Legacy Migration (User already in memberUids)
          // Allows existing legacy users to backfill their member document
          (request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.get('memberUids', []))
        );

        // Security Fix: Prevent IDOR (Insecure Direct Object Reference)
        // Previous rule allowed ANY member to update ANY other member's non-role fields.
        // New rule restricts updates to:
        // 1. The user themselves (but they cannot change their own role)
        // 2. Household Admins (can update any field including role)
        allow update: if isMemberOf(householdId) && (
          // 🛡️ SENTINEL SECURITY FIX: Enforce input validation on profile updates to prevent storage exhaustion
          // Use .get() to safely access optional fields; if missing, defaults to null which isValidOptionalString accepts
          // DisplayName is required
          isValidString(request.resource.data.get('displayName', null), 50) &&
          isValidOptionalString(request.resource.data.get('email', null), 100) &&
          isValidOptionalString(request.resource.data.get('telegramChatId', null), 50) &&
          isValidOptionalString(request.resource.data.get('photoURL', null), 500) &&

          // Validate notificationPreferences (Map) if present
          (
            !request.resource.data.keys().hasAny(['notificationPreferences']) ||
            (
              request.resource.data.notificationPreferences is map &&
              isValidOptionalString(request.resource.data.notificationPreferences.get('time', null), 10) &&
              isValidOptionalString(request.resource.data.notificationPreferences.get('timezone', null), 100)
            )
          ) &&

          (
            // Case 1: User updating their own profile (cannot change role)
            (request.auth.uid == memberId && !request.resource.data.diff(resource.data).changedKeys().hasAny(['role'])) ||
            // Case 2: Admin updating any member (including role)
            isAdminOf(householdId)
          )
        );

        allow delete: if isAdminOf(householdId) || request.auth.uid == memberId;
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow read: if isMemberOf(householdId);

        // 🛡️ SENTINEL SECURITY FIX: Split write into create/update/delete to enforce validation
        // Prevent DoS/Storage Exhaustion by validating string lengths
        // Title and Category are required (isValidString checks for non-null), telegramAlias is optional
        allow create, update: if isMemberOf(householdId) &&
                              isValidString(request.resource.data.get('title', null), 100) &&
                              isValidString(request.resource.data.get('category', null), 50) &&
                              isValidOptionalString(request.resource.data.get('telegramAlias', null), 50) &&
                              isValidOptionalString(request.resource.data.get('presetId', null), 50);

        allow delete: if isMemberOf(householdId);

        // Habit submissions subcollection
        match /submissions/{submissionId} {
          allow read: if isMemberOf(householdId);
          allow write: if isMemberOf(householdId);
        }
      }

      // API Keys subcollection - Admin only (for iOS Shortcuts integration)
      match /apiKeys/{keyId} {
        // Only admins can read API keys
        allow read: if isAdminOf(householdId);

        // Only admins can create new API keys
        allow create: if isAdminOf(householdId) &&
          request.resource.data.keys().hasAll(['hashedKey', 'keyPrefix', 'name', 'status', 'permissions', 'createdAt', 'createdBy', 'usageCount']);

        // Only admins can update, but cannot modify the hashedKey or keyPrefix (security)
        allow update: if isAdminOf(householdId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hashedKey', 'keyPrefix', 'createdAt', 'createdBy']);

        // Only admins can delete API keys
        allow delete: if isAdminOf(householdId);
      }

      // API Usage tracking subcollection (rate limiting)
      match /apiUsage/{endpoint} {
        // Members can read their own usage
        allow read: if isMemberOf(householdId);
        // Cloud Functions update this via Admin SDK, but allow admin updates for testing
        allow write: if isAdminOf(householdId);
      }

      // Shopping list subcollection with input validation
      match /shoppingList/{itemId} {
        allow read: if isMemberOf(householdId);

        // 🛡️ SENTINEL SECURITY FIX: Validate shopping list items to prevent storage exhaustion
        allow create, update: if isMemberOf(householdId) &&
                              isValidString(request.resource.data.get('name', null), 100) &&
                              isValidOptionalString(request.resource.data.get('category', null), 50);

        allow delete: if isMemberOf(householdId);
      }

      // Transactions subcollection with input validation
      match /transactions/{transactionId} {
        allow read: if isMemberOf(householdId);
        // 🛡️ SENTINEL SECURITY FIX: Enforce type and length validation to prevent storage exhaustion and data corruption
        allow create, update: if isMemberOf(householdId) &&
                              isValidNumber(request.resource.data.amount) &&
                              isValidString(request.resource.data.merchant, 100) &&
                              isValidString(request.resource.data.category, 50) &&
                              isValidString(request.resource.data.date, 10) && // YYYY-MM-DD
                              // Optional fields
                              isValidOptionalString(request.resource.data.get('notes', null), 500) &&
                              isValidOptionalString(request.resource.data.get('payPeriodId', null), 20) &&
                              isValidOptionalString(request.resource.data.get('source', null), 20) &&
                              // Booleans
                              (request.resource.data.get('isRecurring', null) == null || isValidBoolean(request.resource.data.isRecurring)) &&
                              (request.resource.data.get('autoCategorized', null) == null || isValidBoolean(request.resource.data.autoCategorized)) &&
                              // Arrays (basic type check)
                              (request.resource.data.get('relatedHabitIds', null) == null || request.resource.data.relatedHabitIds is list) &&
                              // Status enum validation
                              (request.resource.data.get('status', null) == null || request.resource.data.status in ['verified', 'pending_review']);

        allow delete: if isMemberOf(householdId);
      }

      // Accounts subcollection
      match /accounts/{accountId} {
        allow read: if isMemberOf(householdId);

        // Helper to validate account schema
        function isValidAccount() {
          return isValidString(request.resource.data.name, 50) &&
                 request.resource.data.type in ['checking', 'savings', 'credit'] &&
                 isValidNumber(request.resource.data.balance) &&
                 request.resource.data.lastUpdated is timestamp &&
                 isValidOptionalNumber(request.resource.data.get('monthlyGoal', null)) &&
                 isValidOptionalNumber(request.resource.data.get('order', null));
        }

        // 🛡️ SENTINEL SECURITY FIX: Enforce schema validation for accounts
        allow create: if isMemberOf(householdId) &&
                      isValidAccount() &&
                      request.resource.data.createdBy == request.auth.uid;

        allow update: if isMemberOf(householdId) &&
                      isValidAccount() &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);

        allow delete: if isMemberOf(householdId);
      }

      // All other subcollections (buckets, calendarItems, pantry, meals, etc.)
      // Proper multi-household isolation using member document checks
      // Specific collections with custom rules are excluded below
      match /{subcollection}/{document} {
        // 🛡️ CRITICAL: Exclude apiKeys from read to prevent bypass of admin-only access
        allow read: if isMemberOf(householdId) && subcollection != 'apiKeys';
        allow write: if isMemberOf(householdId) &&
                     subcollection != 'members' &&
                     subcollection != 'habits' &&
                     subcollection != 'shoppingList' &&
                     subcollection != 'apiKeys' &&
                     subcollection != 'apiUsage' &&
                     subcollection != 'transactions' &&
                     subcollection != 'accounts';
      }
    }

    // Invite codes collection
    match /inviteCodes/{code} {
      allow get: if isAuthenticated(); // Prevent listing (Information Disclosure)
      allow list: if false;
      // Only household creators can create invite codes
      allow create: if isAuthenticated() &&
                    get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.createdBy == request.auth.uid;
      allow update, delete: if false; // Invite codes shouldn't be modified or deleted
    }

    // Global App Config (Kill Switch)
    match /app_config/global {
      allow read: if true;
      allow write: if request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2"; // TODO: Replace with actual Admin UID
    }

    // Beta Testers
    match /beta_testers/{docId} {
      // 🛡️ SENTINEL SECURITY FIX: Prevent enumeration of all beta testers
      // Only allow reading if the document belongs to the user (via email match) or if user is Admin.
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2"
      );
      allow write: if request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2"; // TODO: Replace with actual Admin UID
    }

    // Feedback Reports
    match /feedback/{reportId} {
      allow create: if isAuthenticated();
      allow read, delete: if request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2"; // TODO: Replace with actual Admin UID
    }

    // AI Usage Logs
    match /logs/ai_usage/requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2"; // TODO: Replace with actual Admin UID
    }
  }
}
